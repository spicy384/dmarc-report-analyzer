# Copy to .env and edit before starting:  cp .env.example .env

# The domain this will be served on. Its DNS record must point at this host,
# and ports 80 and 443 must be reachable from the internet for Let's Encrypt
# to validate it.
DMARC_DOMAIN=dmarc.example.com

# Where Let's Encrypt sends certificate expiry warnings. Optional.
ACME_EMAIL=you@example.com

# Timezone for timestamps shown in the app.
TZ=UTC

# Microsoft 365 access - see "Entra app registration" in the main README.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=paste-the-client-secret-value-here
DMARC_MAILBOX=dmarc-reports@example.com
DMARC_FOLDER=Inbox
SYNC_INTERVAL_MINUTES=60
BACKFILL_DAYS=90
